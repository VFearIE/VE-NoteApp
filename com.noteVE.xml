<?xml version="1.0" encoding="utf-8"?>
<permissions>
    <!-- No signature|privileged permissions are required by this release.
         Normal permissions are manifest-granted; dangerous permissions use runtime grants.
         USE_FULL_SCREEN_INTENT is app-op controlled on Android 14+.
         GRANT_RUNTIME_PERMISSIONS is signature/installer, NOT privileged on AOSP. -->
    <privapp-permissions package="com.noteVE" />
</permissions>
